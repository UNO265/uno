[
 {"id": "n0", "sec": "notice", "scene": "silent", "p": {"view": "notice"}, "dur": 5},
 {"id": "h1", "sec": "hook", "scene": "stage", "p": {"view": "hookQuote"}, "s": ["“여러분, 하던 얘기를 계속하겠습니다.”"]},
 {"id": "h2", "sec": "hook", "scene": "stage", "p": {"view": "date"}, "s": ["【기록】1974년 8월 15일."]},
 {"id": "h3", "sec": "hook", "scene": "stage", "p": {"view": "flyin"}, "s": ["【기록】총소리가 울리고 몇 분 뒤 연단에 다시 선 대통령이 한 말입니다."]},
 {"id": "h4", "sec": "hook", "scene": "stage", "p": {"view": "seat"}, "s": ["【기록】그 사이 영부인 육영수 여사는 머리에 총을 맞고 실려 나갔습니다.", "그리고 그날 저녁 숨을 거뒀습니다."]},
 {"id": "h5", "sec": "hook", "scene": "stage", "p": {"view": "verdict"}, "s": ["【기록】범인 문세광은 넉 달 뒤 사형됐습니다.", "판결은 끝났습니다."]},
 {"id": "h6", "sec": "hook", "scene": "stage", "p": {"view": "memo"}, "s": ["그런데 반세기가 지난 지금도 공개된 기록으로 확인할 수 없는 것이 하나 있습니다."]},
 {"id": "h7", "sec": "hook", "scene": "stage", "p": {"view": "bullet"}, "s": ["【미공개】육 여사를 맞힌 그 총알.", "탄두는 어디로 갔을까요?"], "hold": 1.0},
 {"id": "t0", "sec": "hook", "scene": "silent", "p": {"view": "title"}, "dur": 4.5},
 {"id": "p1", "sec": "prologue", "scene": "stage", "p": {"view": "film"}, "s": ["올해 9월 한 편의 영화가 개봉했습니다.", "제목은 「암살자(들)」."]},
 {"id": "p2", "sec": "prologue", "scene": "stage", "p": {"view": "counter"}, "s": ["【기록】나흘 만에 관객 100만 명을 넘었습니다."]},
 {"id": "p3", "sec": "prologue", "scene": "stage", "p": {"view": "paren"}, "s": ["제목 끝 괄호 속 한 글자 「들」이 논쟁에 불을 붙였습니다."]},
 {"id": "p4", "sec": "prologue", "scene": "stage", "p": {"view": "statements"}, "s": ["【기록】기념재단은 상영 중단을 요구했고 제작진은 역사를 왜곡할 목적이 없다고 밝혔습니다."]},
 {"id": "p5", "sec": "prologue", "scene": "stage", "p": {"view": "grades", "step": 0}, "s": ["이 영상은 영화가 맞는지 틀렸는지 판정하지 않습니다.", "대신 1974년의 기록을 세 가지로 나눠 봅니다."]},
 {"id": "p6", "sec": "prologue", "scene": "stage", "p": {"view": "grades", "step": 1}, "s": ["기록으로 확인된 것.", "누군가 증언하거나 주장한 것.", "그리고 공개된 기록이 없는 것."]},
 {"id": "p7", "sec": "prologue", "scene": "stage", "p": {"view": "gradeDemo"}, "s": ["화면 왼쪽 위의 표시가 지금 듣는 문장이 어디에 속하는지 알려 드립니다."], "hold": 0.6},
 {"id": "c1", "sec": "ch1", "scene": "chapter", "p": {"view": "chapter", "num": "1장", "title": "그날 오전"}},
 {"id": "a1", "sec": "ch1", "scene": "stage", "p": {"view": "profile"}, "s": ["육영수.", "【기록】1925년 충청북도 옥천에서 태어났습니다."]},
 {"id": "a2", "sec": "ch1", "scene": "stage", "p": {"view": "yadang"}, "s": ["대통령의 부인이었지만 여론을 모아 대통령에게 쓴소리를 전하곤 했습니다.", "【기록】그래서 「청와대 안의 야당」이라는 말을 들었습니다."]},
 {"id": "a3", "sec": "ch1", "scene": "stage", "p": {"view": "age"}, "s": ["1974년 여름 그의 나이는 마흔여덟이었습니다."]},
 {"id": "a4", "sec": "ch1", "scene": "stage", "p": {"view": "hall", "cam": "orbit"}, "s": ["8월 15일 오전.", "【기록】서울 장충동 국립극장에서 제29회 광복절 기념식이 열렸습니다."]},
 {"id": "a5", "sec": "ch1", "scene": "stage", "p": {"view": "hall", "cam": "audience", "chip": "1,000여 명"}, "s": ["【기록】각계 인사 1,000여 명이 객석을 채웠습니다."]},
 {"id": "a6", "sec": "ch1", "scene": "stage", "p": {"view": "hall", "cam": "podium", "marks": ["podium", "seat"]}, "s": ["무대 가운데에는 대통령의 연단.", "그 뒤편 귀빈석에 육영수 여사가 앉아 있었습니다."]},
 {"id": "a7", "sec": "ch1", "scene": "stage", "p": {"view": "hall", "cam": "chorus", "marks": ["chorus", "broadcast"]}, "s": ["【기록】객석 앞쪽에는 축가를 부르러 온 여고생 합창단이 있었습니다.", "기념식은 텔레비전과 라디오로 전국에 중계되고 있었습니다."]},
 {"id": "a8", "sec": "ch1", "scene": "stage", "p": {"view": "hall", "cam": "aisle", "marks": ["podium", "shooter"]}, "s": ["대통령이 경축사를 읽던 중이었습니다.", "【기록】객석에서 한 남자가 일어나 통로로 달려 나오며 권총을 쐈습니다."]},
 {"id": "a9", "sec": "ch1", "scene": "stage", "p": {"view": "shots", "shots": [], "done": []}, "s": ["【기록】대법원 판결에 적힌 총알은 다섯 발입니다."]},
 {"id": "a10", "sec": "ch1", "scene": "stage", "p": {"view": "shots", "shots": [1, 2, 3], "done": []}, "s": ["첫 발은 총을 꺼내다 자기 허벅지에 맞았습니다.", "두 번째는 연단에 맞았습니다.", "세 번째는 발사되지 않았습니다."]},
 {"id": "a11", "sec": "ch1", "scene": "stage", "p": {"view": "shots", "shots": [4, 5], "done": [1, 2, 3]}, "s": ["네 번째가 육 여사의 머리를 맞혔습니다.", "다섯 번째는 무대 뒤 태극기에 맞았습니다."]},
 {"id": "a12", "sec": "ch1", "scene": "stage", "p": {"view": "hall", "cam": "chorusClose", "marks": ["guards", "jang"]}, "s": ["경호원들이 남자를 향해 총을 쐈습니다.", "그중 한 발이 빗나갔습니다.", "【기록】그 총알은 합창단 자리에 있던 고등학교 2학년 장봉화 학생에게 맞았습니다."]},
 {"id": "a13", "sec": "ch1", "scene": "stage", "p": {"view": "score", "mode": "short"}, "s": ["【기록】장봉화 학생은 끝내 숨졌습니다."]},
 {"id": "a14", "sec": "ch1", "scene": "stage", "p": {"view": "dayline"}, "s": ["육 여사는 서울대병원으로 옮겨져 긴 뇌수술을 받았습니다.", "【기록】그러나 그날 오후 7시쯤 세상을 떠났습니다.", "나흘 뒤 국민장이 치러졌습니다."]},
 {"id": "a15", "sec": "ch1", "scene": "stage", "p": {"view": "hall", "cam": "return", "marks": ["podium"]}, "s": ["다시 그날 오전 식장.", "총격 몇 분 뒤 대통령은 연단에 다시 섰습니다.", "그리고 말했습니다."]},
 {"id": "a16", "sec": "ch1", "scene": "stage", "p": {"view": "hookQuote"}, "s": ["“여러분, 하던 얘기를 계속하겠습니다.”", "【기록】경축사는 끝까지 읽혔습니다."], "hold": 0.8},
 {"id": "c2", "sec": "ch2", "scene": "chapter", "p": {"view": "chapter", "num": "2장", "title": "한 남자"}},
 {"id": "b1", "sec": "ch2", "scene": "stage", "p": {"view": "suspect"}, "s": ["현장에서 붙잡힌 남자의 이름은 문세광.", "【기록】일본에서 태어난 재일교포 2세, 스물두 살이었습니다."]},
 {"id": "b2", "sec": "ch2", "scene": "stage", "p": {"view": "route", "step": 0}, "s": ["총은 어디서 왔을까요?", "한 달 전인 7월 18일 일본 오사카의 한 파출소에서 경찰 권총이 사라졌습니다."]},
 {"id": "b3", "sec": "ch2", "scene": "stage", "p": {"view": "route", "step": 1}, "s": ["【기록】문세광이 훔친 총이었습니다.", "이 사실은 한국과 일본 수사 당국이 모두 인정했습니다."]},
 {"id": "b4", "sec": "ch2", "scene": "stage", "p": {"view": "passport"}, "s": ["여권은 남의 이름이었습니다.", "【기록】학창 시절 친구였던 여성의 남편 이름으로 여권을 받았습니다.", "그 여성은 뒤에 일본 법원에서 여권법 위반 등으로 징역 3개월에 집행유예 1년을 선고받았습니다."]},
 {"id": "b5", "sec": "ch2", "scene": "stage", "p": {"view": "route", "step": 2}, "s": ["【기록】8월 6일 문세광은 권총을 숨긴 채 한국에 들어왔습니다.", "9일 뒤 그는 국립극장 객석에 앉아 있었습니다."]},
 {"id": "b6", "sec": "ch2", "scene": "stage", "p": {"view": "trial", "show": [[0], [1], [2], []], "pre": []}, "s": ["재판은 빨랐습니다.", "10월 7일 첫 공판.", "10월 19일 1심 사형 선고.", "【기록】내란목적살인을 포함해 공소 사실 6가지가 모두 유죄로 인정됐습니다."]},
 {"id": "b7", "sec": "ch2", "scene": "stage", "p": {"view": "trial", "show": [[3], [4], [5], []], "pre": [0, 1, 2], "total": true}, "s": ["11월 20일 항소 기각.", "【기록】12월 17일 대법원에서 사형이 확정됐습니다.", "그리고 사흘 뒤인 12월 20일 아침 사형이 집행됐습니다.", "사건부터 집행까지 127일이었습니다."]},
 {"id": "b8", "sec": "ch2", "scene": "stage", "p": {"view": "conclusion"}, "s": ["법원의 결론은 분명합니다.", "【기록】육 여사를 쏜 사람은 문세광이라는 것."], "hold": 0.6},
 {"id": "c3", "sec": "ch3", "scene": "chapter", "p": {"view": "chapter", "num": "3장", "title": "두 나라, 두 결론"}},
 {"id": "d1", "sec": "ch3", "scene": "stage", "p": {"view": "dual", "step": "frozen"}, "s": ["그런데 사건은 법정에서만 끝나지 않았습니다.", "한국과 일본의 관계는 이미 한 해 전부터 얼어붙어 있었습니다."]},
 {"id": "d2", "sec": "ch3", "scene": "stage", "p": {"view": "news1973"}, "s": ["【기록】1973년 8월 도쿄의 호텔에서 야당 정치인 김대중이 납치된 사건 때문이었습니다.", "그때는 일본이 한국에 항의하는 쪽이었습니다.", "【해석】1년 뒤 이번에는 한국이 일본에 책임을 묻게 된 것입니다."]},
 {"id": "d3", "sec": "ch3", "scene": "stage", "p": {"view": "dual", "step": "korea"}, "s": ["한국 수사 당국은 배후를 발표했습니다.", "【기록】북한과 재일본조선인총연합회, 곧 조총련의 지시를 받았다는 것이었습니다."]},
 {"id": "d4", "sec": "ch3", "scene": "stage", "p": {"view": "dual", "step": "japan"}, "s": ["일본의 결론은 달랐습니다.", "권총을 훔친 사실은 확인했습니다.", "【기록】하지만 조총련이 관여했다는 증거는 충분히 찾지 못했다는 입장이었습니다."]},
 {"id": "d5", "sec": "ch3", "scene": "stage", "p": {"view": "dual", "step": "gap"}, "s": ["같은 사건에 두 나라가 서로 다른 결론을 낸 것입니다.", "그 간격은 거리로 번졌습니다.", "【기록】전국에서 반일 시위가 이어졌고 9월 6일에는 시위대가 서울의 일본대사관에 들어가 건물을 부수는 일까지 벌어졌습니다."]},
 {"id": "d6", "sec": "ch3", "scene": "stage", "p": {"view": "archive"}, "s": ["【기록】2005년 30년 만에 공개된 외교문서 약 3,000쪽.", "문서에 따르면 한국 정부는 일본과 국교를 끊는 방안까지 준비했습니다."]},
 {"id": "d7", "sec": "ch3", "scene": "stage", "p": {"view": "envoy"}, "s": ["결국 일본은 특사를 보냈습니다.", "특사는 일본 총리의 친서를 들고 왔습니다.", "【기록】책임을 인정하고 한국 수사에 협조하겠다는 내용이었습니다.", "미국도 두 나라 사이를 중재했습니다."]},
 {"id": "d8", "sec": "ch3", "scene": "stage", "p": {"view": "cable"}, "s": ["미국은 이 사건을 어떻게 봤을까요?", "【기록】국민장 다음 날인 8월 20일 주한 미국대사관이 본국에 보낸 비밀 전문이 올해 공개됐습니다.", "전문은 한국의 분위기를 침통하고 가라앉았다고 적었습니다.", "그리고 대통령이 앞으로 온건해지지 않을 것이라고 내다봤습니다."]},
 {"id": "d9", "sec": "ch3", "scene": "stage", "p": {"view": "memoir", "step": 0}, "s": ["그리고 올해 9월 또 하나의 글이 공개됐습니다.", "【증언】당시 수사에 참여했던 검사 김기춘 전 대통령비서실장의 출간되지 않은 회고록입니다.", "보도에 따르면 회고록에는 이런 내용이 있습니다."]},
 {"id": "d10", "sec": "ch3", "scene": "stage", "p": {"view": "memoir", "step": 1}, "s": ["일본이 공동 수사를 제안했지만 자신이 반대해 무산됐다.", "일본 수사관이 문세광을 직접 조사하면 기존 진술이 바뀔 수 있다고 걱정했다.", "이것은 본인의 기억을 적은 글입니다.", "다른 공개 기록으로 확인된 내용은 아닙니다."], "hold": 0.6},
 {"id": "c4", "sec": "ch4", "scene": "chapter", "p": {"view": "chapter", "num": "4장", "title": "남은 한 고리"}},
 {"id": "e1", "sec": "ch4", "scene": "stage", "p": {"view": "hall", "cam": "top", "marks": ["question"]}, "s": ["이제 처음의 질문으로 돌아갑니다.", "【미공개】육 여사를 맞힌 총알은 어디로 갔을까요?"]},
 {"id": "e2", "sec": "ch4", "scene": "stage", "p": {"view": "rifling", "step": 0}, "s": ["왜 하필 총알일까요.", "총신 안에는 나선 모양의 홈이 파여 있습니다.", "총알은 이 홈을 따라 돌며 날아갑니다."]},
 {"id": "e3", "sec": "ch4", "scene": "stage", "p": {"view": "rifling", "step": 1}, "s": ["그때 총알 표면에 긁힌 자국이 남습니다.", "같은 공장에서 만든 총이라도 이 자국은 총마다 다릅니다.", "그래서 이 자국을 총의 지문이라고 부릅니다.", "탄두 하나만 있으면 어느 총에서 나왔는지 대조할 수 있다는 뜻입니다."]},
 {"id": "e4", "sec": "ch4", "scene": "stage", "p": {"view": "testimony"}, "s": ["먼저 몸 안입니다.", "【증언】수술을 맡았던 신경외과 의사 최길수는 이렇게 증언했습니다.", "총알은 이마로 들어가 머리 뒤쪽으로 빠져나갔다.", "머릿속에서 탄두는 나오지 않았다는 것입니다."]},
 {"id": "e5", "sec": "ch4", "scene": "stage", "p": {"view": "bullet", "mode": "inside"}, "s": ["그렇다면 탄두는 몸 밖 어딘가 식장 안에 있었다는 뜻이 됩니다."]},
 {"id": "e6", "sec": "ch4", "scene": "stage", "p": {"view": "chain", "step": 0}, "s": ["다음은 현장입니다.", "【증언】당시 경호실장이 식장에서 그 탄두를 수거했다는 기록과 증언이 있습니다.", "문제는 그다음입니다."]},
 {"id": "e7", "sec": "ch4", "scene": "stage", "p": {"view": "chain", "step": 1}, "s": ["그 탄두를 누구에게 넘겼는지.", "어디에 어떻게 보관했는지.", "문세광의 권총과 대조하는 감정을 했는지.", "【미공개】지금까지 공개된 자료로는 확인되지 않습니다."], "hold": 0.6},
 {"id": "e8", "sec": "ch4", "scene": "stage", "p": {"view": "waveform"}, "s": ["총소리도 마찬가지입니다.", "【미공개】식장에서 울린 총성이 모두 몇 발이었는지 공식 음향 감정 기록은 공개된 적이 없습니다.", "【주장】그래서 여섯 발, 일곱 발 여러 셈법이 지금도 돌고 있습니다."]},
 {"id": "e9", "sec": "ch4", "scene": "stage", "p": {"view": "claim"}, "s": ["【주장】2005년에는 한 대학 연구팀이 방송 녹음 속 총소리를 분석했습니다.", "결론은 육 여사가 뒤쪽 경호원의 총에 맞았다는 것이었습니다.", "하지만 이것은 한 연구팀의 분석입니다."]},
