   "segments": [
    {
     "text": "コインランドリー、",
     "start": 0.038461538461538464,
     "end": 0.8301073717948718
    },
    {
     "text": "店の数は何倍？",
     "start": 0.9070304487179487,
     "end": 2.076592948717949
    }
   ],
   "voice": "case004_shorts/short2/voice/U01.wav",
