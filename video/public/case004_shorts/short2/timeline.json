   "from": 0,
   "duration": 67
  },
  {
   "id": "U02",
   "segments": [
    {
     "text": "1996年、全国のコインランドリーは、",
     "start": 0.07692307692307693,
     "end": 3.276048076923077
    },
    {
     "text": "約1万店。",
     "start": 3.352971153846154,
     "end": 4.294283653846154
    }
   ],
   "voice": "case004_shorts/short2/voice/U02.wav",
   "voiceStart": 0.07692307692307693,
   "from": 67,
   "duration": 135
  },
  {
   "id": "U03",
   "segments": [
    {
     "text": "2013年には、",
     "start": 0.07692307692307693,
     "end": 1.2898189102564102
    },
    {
     "text": "1万6693店。",
     "start": 1.3821266025641024,
     "end": 3.3336266025641024
    },
    {
     "text": "およそ1.6倍だ。",
     "start": 3.4259342948717952,
     "end": 4.688392628205128
    }
   ],
   "voice": "case004_shorts/short2/voice/U03.wav",
   "voiceStart": 0.07692307692307693,
   "from": 202,
   "duration": 148
  },
  {
   "id": "U04",
   "segments": [
    {
     "text": "その後も増え続け、",
     "start": 0.07692307692307693,
     "end": 1.1657772435897436
    },
    {
     "text": "この10年で、さらに4割ほど増えたと報じられている。",
     "start": 1.2427003205128204,
     "end": 4.248658653846154
    }
   ],
   "voice": "case004_shorts/short2/voice/U04.wav",
   "voiceStart": 0.07692307692307693,
   "from": 350,
   "duration": 133
  },
  {
   "id": "U04B",
   "segments": [
    {
     "text": "お金も同じだ。",
     "start": 0.07692307692307693,
     "end": 0.974923076923077
    },
    {
     "text": "2025年、コインランドリーの市場は、",
     "start": 1.0672307692307692,
     "end": 3.618543269230769
    },
    {
     "text": "1155億円。",
     "start": 3.710850961538462,
     "end": 5.009205128205129
    }
   ],
   "voice": "case004_shorts/short2/voice/U04B.wav",
   "voiceStart": 0.07692307692307693,
   "from": 483,
   "duration": 157
  },
  {
   "id": "U05",
   "segments": [
    {
     "text": "家には、たいてい洗濯機がある。",
     "start": 0.11538461538461538,
     "end": 1.9713637820512822
    },
    {
     "text": "それなのに、店は増えている。",
