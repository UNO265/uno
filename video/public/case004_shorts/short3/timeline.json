   "from": 591,
   "duration": 98
  },
  {
   "id": "V05",
   "segments": [
    {
     "text": "無人だから、売上のほとんどが利益――",
     "start": 0.11538461538461538,
     "end": 2.350592948717949
    },
    {
     "text": "というわけではない。",
     "start": 2.773669871794872,
     "end": 3.6703990384615386
