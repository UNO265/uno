   "id": "V01",
   "segments": [
    {
     "text": "コインランドリーに入れたお金、",
     "start": 0.038461538461538464,
     "end": 1.4602740384615385
    },
    {
     "text": "どこへ消える？",
     "start": 1.5371971153846153,
     "end": 2.340655448717949
    }
   ],
   "voice": "case004_shorts/short3/voice/V01.wav",
   "voiceStart": 0.038461538461538464,
   "from": 0,
   "duration": 75
  },
  {
   "id": "V01B",
   "segments": [
    {
     "text": "客から見れば、お金を入れて、ボタンを押すだけ。",
     "start": 0.07692307692307693,
     "end": 2.8289439102564105
    },
    {
     "text": "でも、そのお金は、そのまま店の利益にはならない。",
     "start": 2.9058669871794875,
     "end": 5.830658653846154
    }
   ],
   "voice": "case004_shorts/short3/voice/V01B.wav",
   "voiceStart": 0.07692307692307693,
   "from": 75,
   "duration": 181
  },
  {
   "id": "V02",
   "segments": [
    {
     "text": "まず、機械が一回動くたびに。",
     "start": 0.07692307692307693,
     "end": 2.0414022435897436
    },
    {
     "text": "水道。",
     "start": 2.1183253205128207,
     "end": 2.6572003205128207
    },
    {
     "text": "電気やガス。",
     "start": 2.734123397435898,
     "end": 3.4606025641025644
    },
    {
     "text": "洗剤。",
     "start": 3.5375256410256415,
     "end": 4.0885881410256415
    }
   ],
   "voice": "case004_shorts/short3/voice/V02.wav",
   "voiceStart": 0.07692307692307693,
   "from": 256,
   "duration": 128
  },
  {
   "id": "V03",
   "segments": [
    {
     "text": "客が来ても、来なくても。",
     "start": 0.07692307692307693,
     "end": 1.6542355769230768
    },
    {
     "text": "家賃。",
     "start": 1.7311586538461536,
     "end": 2.268929487179487
    },
    {
     "text": "清掃。",
     "start": 2.3458525641025645,
     "end": 2.9304983974358976
    },
    {
     "text": "点検や修理。",
     "start": 3.007421474358975,
     "end": 3.923546474358975
    }
   ],
   "voice": "case004_shorts/short3/voice/V03.wav",
   "voiceStart": 0.07692307692307693,
   "from": 384,
   "duration": 123
  },
  {
   "id": "V04",
   "segments": [
    {
     "text": "そして、洗濯機と乾燥機、そのもの。",
     "start": 0.07692307692307693,
     "end": 2.5610689102564104
    }
   ],
   "voice": "case004_shorts/short3/voice/V04.wav",
   "voiceStart": 0.07692307692307693,
   "from": 507,
   "duration": 84
  },
  {
   "id": "V04B",
   "segments": [
    {
     "text": "何台もの大型の機械は、",
     "start": 0.07692307692307693,
     "end": 1.5927564102564102
    },
    {
     "text": "置けば終わり、ではない。",
     "start": 1.669679487179487,
     "end": 3.0774711538461537
