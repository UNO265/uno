     "end": 2.7409054487179487
    }
   ],
   "voice": "case004_shorts/short1/voice/W01.wav",
   "voiceStart": 0.038461538461538464,
   "from": 0,
   "duration": 87
  },
  {
   "id": "W02",
   "segments": [
    {
     "text": "店員はいない。",
     "start": 0.07692307692307693,
     "end": 0.9177772435897436
    },
    {
     "text": "レジもない。",
     "start": 0.9947003205128204,
     "end": 1.6035753205128205
    },
    {
     "text": "それでも機械は、夜まで回り続けている。",
     "start": 1.6804983974358974,
     "end": 4.054310897435897
    }
   ],
   "voice": "case004_shorts/short1/voice/W02.wav",
   "voiceStart": 0.07692307692307693,
   "from": 87,
   "duration": 126
  },
  {
   "id": "W03",
   "segments": [
    {
     "text": "答えは、人件費？",
     "start": 0.11538461538461538,
     "end": 1.6872804487179487
    },
    {
     "text": "それは、半分だけ正しい。",
     "start": 2.071895833333333,
     "end": 3.7252916666666662
    }
   ],
   "voice": "case004_shorts/short1/voice/W03.wav",
   "voiceStart": 0.11538461538461538,
   "from": 213,
   "duration": 119
  },
  {
   "id": "W04",
   "segments": [
    {
     "text": "人の代わりに並んでいるのは、",
     "start": 0.07692307692307693,
     "end": 1.4101939102564103
    },
    {
     "text": "大型の洗濯機と、乾燥機。",
     "start": 1.4871169871794871,
     "end": 3.4013253205128207
    },
    {
     "text": "機械は、無料ではない。",
     "start": 3.4782483974358978,
     "end": 4.902290064102564
    },
    {
     "text": "客が来なくても、そこにある。",
     "start": 4.979213141025641,
     "end": 6.635463141025641
    }
   ],
   "voice": "case004_shorts/short1/voice/W04.wav",
   "voiceStart": 0.07692307692307693,
   "from": 332,
   "duration": 204
  },
  {
   "id": "W05",
   "segments": [
    {
     "text": "つまりコインランドリーは、",
     "start": 0.11538461538461538,
     "end": 1.3220929487179487
    },
    {
     "text": "高価な機械に働いてもらう店だ。",
     "start": 1.3990160256410256,
     "end": 3.1747660256410253
    }
   ],
   "voice": "case004_shorts/short1/voice/W05.wav",
   "voiceStart": 0.11538461538461538,
   "from": 536,
   "duration": 104
  },
  {
   "id": "W06",
   "segments": [
    {
     "text": "でも、家にはたいてい洗濯機がある。",
     "start": 0.11538461538461538,
     "end": 2.219509615384615
    },
    {
     "text": "それなのに市場は、1155億円。",
