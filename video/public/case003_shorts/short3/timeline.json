   "segments": [
    {
     "text": "映画は過去最高のヒット。",
     "start": 0.038461538461538464,
     "end": 1.4870032051282052
    },
    {
     "text": "なのに、チケットは値上げ？",
     "start": 1.563926282051282,
     "end": 3.420801282051282
    }
   ],
   "voice": "case003_shorts/short3/voice/R01.wav",
   "voiceStart": 0.038461538461538464,
   "from": 0,
   "duration": 107
  },
  {
   "id": "R02",
   "segments": [
    {
     "text": "2025年、日本の映画の興行収入は2744億円。",
     "start": 0.07692307692307693,
     "end": 4.518839743589743
    },
    {
     "text": "過去最高だった。",
     "start": 4.59576282051282,
     "end": 5.55926282051282
    }
   ],
   "voice": "case003_shorts/short3/voice/R02.wav",
   "voiceStart": 0.07692307692307693,
   "from": 107,
   "duration": 171
  },
  {
   "id": "R03",
   "segments": [
    {
     "text": "それでも、TOHOシネマズは2023年、",
     "start": 0.11538461538461538,
     "end": 2.7363221153846156
    },
    {
     "text": "一般料金を2000円に。",
     "start": 2.828629807692308,
     "end": 4.379921474358975
    },
    {
     "text": "2026年には、都心の一部で2200円になった。",
     "start": 4.472229166666667,
     "end": 7.8537083333333335
    }
   ],
   "voice": "case003_shorts/short3/voice/R03.wav",
   "voiceStart": 0.11538461538461538,
   "from": 278,
   "duration": 240
  },
  {
   "id": "R04",
   "segments": [
    {
     "text": "挙げられた理由は、",
     "start": 0.11538461538461538,
     "end": 1.1126346153846154
    },
    {
     "text": "エネルギー価格の高騰。",
     "start": 1.1895576923076923,
     "end": 2.4651826923076925
    },
    {
     "text": "円安による仕入れコスト。",
     "start": 2.542105769230769,
     "end": 3.899168269230769
    },
    {
     "text": "人件費や、設備投資。",
     "start": 3.9760913461538463,
     "end": 5.66748717948718
    }
   ],
   "voice": "case003_shorts/short3/voice/R04.wav",
   "voiceStart": 0.11538461538461538,
   "from": 518,
   "duration": 175
  },
  {
   "id": "R05",
   "segments": [
    {
     "text": "しかも、チケット代は、映画館だけのお金ではない。",
     "start": 0.11538461538461538,
     "end": 3.135051282051282
    },
    {
     "text": "作品を届ける側と、分け合う。",
     "start": 3.2273589743589746,
     "end": 5.161442307692308
    }
   ],
   "voice": "case003_shorts/short3/voice/R05.wav",
   "voiceStart": 0.11538461538461538,
   "from": 693,
   "duration": 161
  },
  {
   "id": "R06",
   "segments": [
    {
     "text": "映画がヒットしても、",
     "start": 0.15384615384615385,
     "end": 1.2742628205128206
    },
    {
     "text": "映画館のコストは、待ってくれない。",
     "start": 1.4281089743589743,
     "end": 3.3240464743589744
    }
   ],
   "voice": "case003_shorts/short3/voice/R06.wav",
   "voiceStart": 0.15384615384615385,
   "from": 854,
   "duration": 111
  },
  {
   "id": "R07",
