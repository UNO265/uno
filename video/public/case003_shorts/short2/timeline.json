  {
   "id": "Q01",
   "segments": [
    {
     "text": "映画館は、",
     "start": 0.038461538461538464,
     "end": 0.7644615384615384
    },
    {
     "text": "なぜポップコーンを売るのか？",
     "start": 0.8413846153846153,
     "end": 2.2601554487179487
    }
   ],
   "voice": "case003_shorts/short2/voice/Q01.wav",
   "voiceStart": 0.038461538461538464,
   "from": 0,
   "duration": 72
  },
  {
   "id": "Q02",
   "segments": [
    {
     "text": "主役は映画。",
     "start": 0.07692307692307693,
     "end": 0.944048076923077
    },
    {
     "text": "チケットを売ればいいはずなのに。",
     "start": 1.0363557692307692,
     "end": 2.524397435897436
    }
   ],
   "voice": "case003_shorts/short2/voice/Q02.wav",
   "voiceStart": 0.07692307692307693,
   "from": 72,
   "duration": 80
  },
  {
   "id": "Q03",
   "segments": [
    {
     "text": "答えは、",
     "start": 0.11538461538461538,
     "end": 0.6870304487179487
    },
    {
     "text": "売れる席の数に、限界があるから。",
     "start": 0.8024150641025641,
     "end": 2.9022067307692305
    }
   ],
   "voice": "case003_shorts/short2/voice/Q03.wav",
   "voiceStart": 0.11538461538461538,
   "from": 152,
   "duration": 94
  },
  {
   "id": "Q04",
   "segments": [
    {
     "text": "200席のスクリーンなら、",
     "start": 0.11538461538461538,
     "end": 1.4982387820512821
    },
    {
     "text": "一回の上映で売れるチケットは、最大200枚。",
     "start": 1.5905464743589743,
     "end": 4.4602339743589745
    }
   ],
   "voice": "case003_shorts/short2/voice/Q04.wav",
   "voiceStart": 0.11538461538461538,
   "from": 246,
   "duration": 138
  },
  {
   "id": "Q05",
   "segments": [
    {
     "text": "上映が終わるまで、",
     "start": 0.07692307692307693,
     "end": 1.1049022435897435
    },
    {
     "text": "次の客は入れられない。",
     "start": 1.1818253205128204,
     "end": 2.3712836538461537
    }
   ],
   "voice": "case003_shorts/short2/voice/Q05.wav",
   "voiceStart": 0.07692307692307693,
   "from": 384,
   "duration": 77
  },
  {
   "id": "Q06",
   "segments": [
    {
     "text": "でも、売店なら――",
     "start": 0.11538461538461538,
     "end": 1.4341554487179486
    },
    {
     "text": "座席を増やさなくても、",
     "start": 1.5264631410256408,
     "end": 2.769088141025641
    },
    {
     "text": "一人の客が使う金額を増やせる。",
     "start": 2.8613958333333334,
     "end": 4.671583333333333
    }
   ],
   "voice": "case003_shorts/short2/voice/Q06.wav",
   "voiceStart": 0.11538461538461538,
   "from": 461,
   "duration": 145
  },
  {
   "id": "Q07",
   "segments": [
    {
     "text": "ビジネスの言葉でいえば、",
     "start": 0.15384615384615385,
     "end": 1.3741794871794872
    },
    {
     "text": "「客単価」だ。",
     "start": 1.4895641025641027,
     "end": 2.581334935897436
    }
   ],
   "voice": "case003_shorts/short2/voice/Q07.wav",
   "voiceStart": 0.15384615384615385,
   "from": 606,
   "duration": 89
  },
  {
   "id": "Q08",
   "segments": [
    {
     "text": "では――",
     "start": 0.15384615384615385,
     "end": 0.5937419871794871
    },
    {
     "text": "なぜポップコーンは、あんなに高いのか？",
