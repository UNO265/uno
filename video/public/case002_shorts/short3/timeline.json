   "from": 105,
   "duration": 85
  },
  {
   "id": "G04",
   "segments": [
    {
     "text": "ラーメンには、",
     "start": 0.11538461538461538,
     "end": 0.8498429487179487
    },
    {
     "text": "「安くて、うまい大衆食」",
     "start": 0.9421506410256411,
     "end": 2.703213141025641
    },
    {
     "text": "というイメージが、長くあった。",
     "start": 2.7955208333333337,
     "end": 4.5333125
