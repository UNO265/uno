   "voice": "case002_shorts/short3/voice/G04.wav",
   "voiceStart": 0.11538461538461538,
   "from": 190,
   "duration": 141
  },
  {
   "id": "G05",
   "segments": [
    {
     "text": "材料が上がっても、",
     "start": 0.11538461538461538,
     "end": 1.188238782051282
    },
    {
     "text": "人件費が上がっても、",
     "start": 1.2805464743589743,
     "end": 2.439150641025641
    },
    {
     "text": "その分を値段に乗せにくい。",
