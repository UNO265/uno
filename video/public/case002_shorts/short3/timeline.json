   "from": 331,
   "duration": 122
  },
  {
   "id": "G06",
   "segments": [
    {
     "text": "そこで店は、別の方法を使う。",
     "start": 0.11538461538461538,
     "end": 2.0748221153846154
    },
    {
     "text": "味玉。",
