   "from": 31,
   "duration": 74
  },
  {
   "id": "G03",
   "segments": [
    {
     "text": "1000円を超えるランチは、",
     "start": 0.11538461538461538,
     "end": 1.3638429487179486
    },
    {
     "text": "もう珍しくないのに。",
