   "segments": [
    {
     "text": "ラーメン、一杯1000円。",
     "start": 0.038461538461538464,
     "end": 1.7237532051282052
    }
   ],
   "voice": "case002_shorts/short1/voice/E01.wav",
   "voiceStart": 0.038461538461538464,
   "from": 0,
   "duration": 55
  },
  {
   "id": "E02",
   "segments": [
    {
     "text": "その原価は、",
     "start": 0.07692307692307693,
     "end": 0.845735576923077
    },
    {
     "text": "5年でどれだけ上がった？",
     "start": 0.9226586538461539,
     "end": 2.2874294871794874
    }
   ],
   "voice": "case002_shorts/short1/voice/E02.wav",
   "voiceStart": 0.07692307692307693,
   "from": 55,
   "duration": 73
  },
  {
   "id": "E03",
   "segments": [
    {
     "text": "答えは、",
     "start": 0.11538461538461538,
     "end": 0.6870304487179487
    },
    {
     "text": "100から、141へ。",
     "start": 0.8024150641025641,
     "end": 2.6615608974358973
    }
   ],
   "voice": "case002_shorts/short1/voice/E03.wav",
   "voiceStart": 0.11538461538461538,
   "from": 128,
   "duration": 87
  },
  {
   "id": "E04",
   "segments": [
    {
     "text": "帝国データバンクの「ラーメン原価指数」。",
     "start": 0.11538461538461538,
     "end": 2.322967948717949
    },
    {
     "text": "東京都区部の豚骨ラーメンを想定した、",
     "start": 2.4152756410256413,
     "end": 4.494421474358974
    },
    {
     "text": "原材料コストの指数だ。",
     "start": 4.586729166666666,
     "end": 5.988916666666666
    }
   ],
   "voice": "case002_shorts/short1/voice/E04.wav",
   "voiceStart": 0.11538461538461538,
   "from": 215,
   "duration": 184
  },
  {
   "id": "E05",
   "segments": [
    {
     "text": "2020年を100とすると、",
     "start": 0.11538461538461538,
     "end": 1.6879471153846155
    },
    {
     "text": "2025年は、141。",
     "start": 1.803331730769231,
     "end": 4.047790064102564
    }
   ],
   "voice": "case002_shorts/short1/voice/E05.wav",
   "voiceStart": 0.11538461538461538,
   "from": 399,
   "duration": 128
  },
  {
   "id": "E06",
   "segments": [
    {
     "text": "すべての店が、41％上がったわけではない。",
     "start": 0.11538461538461538,
     "end": 3.166905448717949
    },
    {
     "text": "でも、材料の値段は、大きく上がってきた。",
     "start": 3.2822900641025643,
     "end": 5.967519230769231
    }
   ],
   "voice": "case002_shorts/short1/voice/E06.wav",
   "voiceStart": 0.11538461538461538,
   "from": 527,
   "duration": 185
  },
  {
   "id": "E07",
   "segments": [
    {
     "text": "しかも、店が払うのは材料だけではない。",
     "start": 0.11538461538461538,
     "end": 2.4672596153846156
    },
    {
     "text": "光熱費。",
     "start": 2.559567307692308,
     "end": 3.231067307692308
    },
    {
     "text": "人件費。",
     "start": 3.3233750000000004,
     "end": 4.003895833333334
    },
    {
     "text": "家賃。",
     "start": 4.096203525641026,
     "end": 4.633974358974359
    }
   ],
   "voice": "case002_shorts/short1/voice/E07.wav",
   "voiceStart": 0.11538461538461538,
   "from": 712,
   "duration": 144
  },
  {
   "id": "E08",
   "segments": [
    {
     "text": "1000円は変わらなくても、",
     "start": 0.15384615384615385,
     "end": 1.5612003205128206
    },
    {
     "text": "1000円の中身は変わる。",
     "start": 1.7150464743589744,
     "end": 3.056963141025641
    }
   ],
   "voice": "case002_shorts/short1/voice/E08.wav",
   "voiceStart": 0.15384615384615385,
   "from": 856,
   "duration": 103
  },
  {
   "id": "E09",
   "segments": [
    {
     "text": "では――",
     "start": 0.15384615384615385,
     "end": 0.5937419871794871
    },
    {
     "text": "値段を上げれば、いいのでは？",
     "start": 0.824511217948718,
     "end": 2.6892195512820516
    }
   ],
   "voice": "case002_shorts/short1/voice/E09.wav",
