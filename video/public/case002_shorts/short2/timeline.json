  {
   "id": "F02",
   "segments": [
    {
     "text": "ラーメン店の市場は、過去最高。",
     "start": 0.07692307692307693,
     "end": 2.0646314102564105
    },
    {
     "text": "なら、儲かっている？",
     "start": 2.1415544871794876,
     "end": 3.6064711538461545
    }
   ],
   "voice": "case002_shorts/short2/voice/F02.wav",
   "voiceStart": 0.07692307692307693,
   "from": 54,
   "duration": 113
  },
  {
   "id": "F03",
   "segments": [
    {
     "text": "ところが、",
     "start": 0.11538461538461538,
     "end": 0.6810512820512821
    },
    {
     "text": "利益は、ほぼ半分になった。",
     "start": 0.7964358974358975,
     "end": 2.5120817307692307
    }
   ],
   "voice": "case002_shorts/short2/voice/F03.wav",
   "voiceStart": 0.11538461538461538,
   "from": 167,
   "duration": 82
  },
  {
   "id": "F04",
   "segments": [
    {
     "text": "2025年度のラーメン店市場は、見込みで8855億円。",
     "start": 0.11538461538461538,
     "end": 4.365134615384615
    },
    {
     "text": "10年前の5418億円から、",
     "start": 4.457442307692307,
     "end": 6.783608974358973
    },
    {
     "text": "63.4％増えた。",
     "start": 6.875916666666665,
     "end": 8.773666666666665
    }
   ],
   "voice": "case002_shorts/short2/voice/F04.wav",
   "voiceStart": 0.11538461538461538,
   "from": 249,
   "duration": 268
  },
  {
   "id": "F05",
   "segments": [
    {
     "text": "主要チェーンの店舗数も、",
     "start": 0.11538461538461538,
     "end": 1.5094471153846154
    },
    {
     "text": "6305店で過去最多。",
     "start": 1.6017548076923076,
     "end": 3.446358974358974
    }
   ],
   "voice": "case002_shorts/short2/voice/F05.wav",
   "voiceStart": 0.11538461538461538,
   "from": 517,
   "duration": 109
  },
  {
   "id": "F06",
   "segments": [
    {
     "text": "でも、損益を確認できた企業の、純損益の合計は、",
     "start": 0.11538461538461538,
     "end": 3.6384262820512823
    },
    {
     "text": "前年度の356億円から、",
     "start": 3.7538108974358977,
     "end": 5.858081730769231
    },
    {
     "text": "171億円へ。",
     "start": 5.973466346153845,
     "end": 7.419903846153845
    }
   ],
   "voice": "case002_shorts/short2/voice/F06.wav",
   "voiceStart": 0.11538461538461538,
   "from": 626,
   "duration": 230
  },
  {
   "id": "F07",
   "segments": [
    {
     "text": "売上が増えても、",
     "start": 0.11538461538461538,
     "end": 1.1423012820512821
    },
    {
     "text": "それ以上にコストが増えれば、",
     "start": 1.2346089743589743,
     "end": 2.6327964743589742
    },
    {
     "text": "利益は増えない。",
     "start": 2.7251041666666667,
     "end": 3.6039375
    }
   ],
   "voice": "case002_shorts/short2/voice/F07.wav",
   "voiceStart": 0.11538461538461538,
   "from": 856,
   "duration": 114
  },
  {
   "id": "F08",
   "segments": [
    {
     "text": "売れている。",
     "start": 0.15384615384615385,
     "end": 0.7217836538461538
    },
    {
     "text": "でも、残らない。",
     "start": 0.991014423076923,
     "end": 2.15549358974359
    }
   ],
   "voice": "case002_shorts/short2/voice/F08.wav",
