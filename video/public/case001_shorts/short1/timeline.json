 "cuts": [
  {
   "id": "A01",
   "segments": [
    {
     "text": "100円ショップは、なぜ100円で儲かるのか？",
     "start": 0.11538461538461538,
     "end": 2.7381346153846153
    }
   ],
   "voice": "case001_shorts/short1/voice/A01.wav",
   "voiceStart": 0.11538461538461538,
   "from": 0,
   "duration": 89
  },
  {
   "id": "A02",
   "segments": [
    {
     "text": "国内の100円ショップ市場は、",
     "start": 0.15384615384615385,
     "end": 1.7903878205128203
    },
    {
     "text": "約1兆1100億円。",
     "start": 2.005772435897436,
     "end": 3.478897435897436
    }
   ],
   "voice": "case001_shorts/short1/voice/A02.wav",
   "voiceStart": 0.15384615384615385,
   "from": 89,
   "duration": 112
  },
  {
   "id": "A03",
   "segments": [
    {
     "text": "でも、",
     "start": 0.15384615384615385,
     "end": 0.6199503205128205
    },
    {
     "text": "100円の商品一つで、大きく儲けているわけではない。",
     "start": 0.8353349358974359,
     "end": 3.886376602564103
    }
   ],
   "voice": "case001_shorts/short1/voice/A03.wav",
   "voiceStart": 0.15384615384615385,
   "from": 201,
   "duration": 125
  },
  {
   "id": "A04",
   "segments": [
    {
     "text": "手がかりは、三つ。",
     "start": 0.15384615384615385,
     "end": 1.480179487179487
    }
   ],
   "voice": "case001_shorts/short1/voice/A04.wav",
   "voiceStart": 0.15384615384615385,
   "from": 326,
   "duration": 51
  },
  {
   "id": "A05",
   "segments": [
    {
     "text": "まず、",
     "start": 0.15384615384615385,
     "end": 0.6048878205128205
    },
    {
     "text": "大量に仕入れて、",
     "start": 0.7587339743589744,
     "end": 1.733838141025641
    },
    {
     "text": "一つあたりのコストを下げる。",
     "start": 1.8876842948717947,
     "end": 3.214205128205128
    }
   ],
   "voice": "case001_shorts/short1/voice/A05.wav",
   "voiceStart": 0.15384615384615385,
   "from": 377,
   "duration": 103
  },
  {
   "id": "A06",
   "segments": [
    {
     "text": "次に、",
     "start": 0.15384615384615385,
     "end": 0.6712211538461539
    },
    {
     "text": "原価の違う商品を組み合わせて、",
     "start": 0.8250673076923077,
     "end": 2.5991923076923076
    },
    {
     "text": "店全体で利益を出す。",
     "start": 2.7530384615384613,
     "end": 4.094455128205128
    }
   ],
   "voice": "case001_shorts/short1/voice/A06.wav",
   "voiceStart": 0.15384615384615385,
   "from": 480,
   "duration": 130
  },
  {
   "id": "A07",
   "segments": [
    {
     "text": "そして、",
     "start": 0.15384615384615385,
     "end": 0.6369503205128205
    },
    {
     "text": "「ついで買い」で、",
     "start": 0.7907964743589744,
     "end": 1.9526089743589743
    },
    {
     "text": "一人あたりの買い物を増やす。",
     "start": 2.106455128205128,
     "end": 3.570455128205128
    }
   ],
   "voice": "case001_shorts/short1/voice/A07.wav",
   "voiceStart": 0.15384615384615385,
   "from": 610,
   "duration": 119
  },
  {
   "id": "A08",
   "segments": [
    {
     "text": "100円は、ただの値段ではない。",
     "start": 0.23076923076923075,
     "end": 2.093206730769231
    },
    {
     "text": "ビジネスのルールだった。",
     "start": 2.5547451923076925,
     "end": 3.6647451923076924
    }
   ],
   "voice": "case001_shorts/short1/voice/A08.wav",
   "voiceStart": 0.23076923076923075,
   "from": 729,
   "duration": 124
  },
  {
   "id": "A09",
   "segments": [
    {
     "text": "続きは本編で。",
     "start": 0.15384615384615385,
     "end": 1.206991987179487
    },
    {
     "text": "カネナゾ。",
     "start": 1.4223766025641025,
     "end": 2.006334935897436
    }
   ],
