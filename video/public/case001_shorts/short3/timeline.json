   "voice": "case001_shorts/short3/voice/D04.wav",
   "voiceStart": 0.2,
   "from": 524,
   "duration": 187
  },
  {
   "id": "D05",
   "segments": [
    {
     "text": "100円という入口を残しながら、",
     "start": 0.2,
     "end": 2.574229166666667
