   "from": 137,
   "duration": 120
  },
  {
   "id": "D03",
   "segments": [
    {
     "text": "普通の店なら、値上げすればいい。",
     "start": 0.2,
     "end": 2.5147083333333335
    },
    {
     "text": "でも100円ショップが値上げすれば、",
     "start": 2.7147083333333337,
     "end": 4.869479166666667
    },
    {
     "text": "もう「100円ショップ」ではなくなってしまう。",
