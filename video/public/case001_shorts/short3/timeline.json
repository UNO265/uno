     "end": 3.8331298076923077
    }
   ],
   "voice": "case001_shorts/short3/voice/D05.wav",
   "voiceStart": 0.15384615384615385,
   "from": 557,
   "duration": 123
  },
  {
   "id": "D06",
   "segments": [
    {
     "text": "一方、Seriaは、100円にこだわる。",
     "start": 0.15384615384615385,
     "end": 2.583429487179487
    }
   ],
   "voice": "case001_shorts/short3/voice/D06.wav",
   "voiceStart": 0.15384615384615385,
   "from": 680,
   "duration": 84
  },
  {
   "id": "D07",
   "segments": [
    {
     "text": "値段を確かめなくても選べる。",
     "start": 0.15384615384615385,
     "end": 1.6514294871794872
    },
    {
     "text": "その分かりやすさが、ブランドの価値になる。",
