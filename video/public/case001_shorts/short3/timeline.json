   "duration": 107
  },
  {
   "id": "D02",
   "segments": [
    {
     "text": "原材料も、物流費も、人件費も上がる。",
     "start": 0.15384615384615385,
     "end": 2.913929487179487
    }
   ],
   "voice": "case001_shorts/short3/voice/D02.wav",
   "voiceStart": 0.15384615384615385,
   "from": 107,
   "duration": 94
  },
  {
   "id": "D03",
   "segments": [
    {
     "text": "普通の店なら、値上げすればいい。",
     "start": 0.15384615384615385,
     "end": 1.9897836538461537
    },
    {
     "text": "でも100円ショップが値上げすれば、",
     "start": 2.1436298076923075,
     "end": 3.8203798076923077
    },
    {
     "text": "もう「100円ショップ」ではなくなってしまう。",
     "start": 3.974225961538461,
     "end": 6.667934294871794
    }
   ],
   "voice": "case001_shorts/short3/voice/D03.wav",
   "voiceStart": 0.15384615384615385,
   "from": 201,
   "duration": 208
  },
  {
   "id": "D04",
   "segments": [
    {
     "text": "DAISOは、100円を超えていく。",
     "start": 0.15384615384615385,
     "end": 2.087429487179487
    },
    {
     "text": "200円。",
     "start": 2.2258910256410256,
     "end": 2.9426410256410254
    },
    {
     "text": "300円。",
     "start": 3.0811025641025642,
     "end": 3.866831730769231
    },
    {
     "text": "500円。",
     "start": 4.005293269230769,
     "end": 4.695689102564103
    }
   ],
   "voice": "case001_shorts/short3/voice/D04.wav",
   "voiceStart": 0.15384615384615385,
   "from": 409,
   "duration": 148
  },
  {
   "id": "D05",
   "segments": [
    {
     "text": "100円という入口を残しながら、",
     "start": 0.15384615384615385,
     "end": 2.020908653846154
    },
    {
     "text": "その先の選択肢を広げている。",
