   "voice": "case001_shorts/short3/voice/D03.wav",
   "voiceStart": 0.2,
   "from": 257,
   "duration": 267
  },
  {
   "id": "D04",
   "segments": [
    {
     "text": "DAISOは、100円を超えていく。",
     "start": 0.2,
     "end": 2.6487083333333334
    },
    {
