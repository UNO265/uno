[
  {"id": "G01", "text": "1000円の壁。", "lead": 0.05, "tail": 0.15},
  {"id": "G02", "text": "ラーメンは、/なぜ簡単に値上げできない？", "lead": 0.1, "tail": 0.2, "gap": 0.1},
  {"id": "G03", "text": "1000円を超えるランチは、/もう珍しくないのに。", "lead": 0.15, "tail": 0.3, "gap": 0.12},
  {"id": "G04", "text": "ラーメンには、/「安くて、うまい大衆食」/というイメージが、長くあった。", "lead": 0.15, "tail": 0.2, "gap": 0.12},
  {"id": "G05", "text": "材料が上がっても、/人件費が上がっても、/その分を値段に乗せにくい。", "lead": 0.15, "tail": 0.25, "gap": 0.12},
  {"id": "G06", "text": "そこで店は、別の方法を使う。/味玉。/チャーシュー。/餃子。/セット。", "lead": 0.15, "tail": 0.2, "gap": 0.12},
  {"id": "G07", "text": "一杯の値段ではなく、/一人の客が使う金額、/「客単価」を上げる。", "lead": 0.2, "tail": 0.5, "gap": 0.2},
  {"id": "G08", "text": "では――/その1000円、最後に店に残るのは、いくら？", "lead": 0.2, "tail": 1.0, "pauses": {"1": 0.3}}
]
