[
  {"id": "P01", "text": "映画のチケット、/実際に払われている平均は、いくら？", "lead": 0.05, "tail": 0.2, "gap": 0.1},
  {"id": "P02", "text": "都心の一部の映画館では、/一般料金が2200円。", "lead": 0.1, "tail": 0.2, "gap": 0.1},
  {"id": "P03", "text": "答えは、/1454円。", "lead": 0.15, "tail": 0.4, "pauses": {"1": 0.3}},
  {"id": "P04", "text": "日本映画製作者連盟が発表した、/2025年の平均入場料金だ。", "lead": 0.1, "tail": 0.2, "gap": 0.1},
  {"id": "P05", "text": "学生。/子ども。/シニア。/割引の日に、レイトショー。", "lead": 0.15, "tail": 0.2, "gap": 0.1},
  {"id": "P06", "text": "チケットは、/一つの値段で売られているわけではない。", "lead": 0.15, "tail": 0.25, "gap": 0.1},
  {"id": "P07", "text": "定価と、実際に払う金額は、/ずいぶん違う。", "lead": 0.2, "tail": 0.5, "gap": 0.2},
  {"id": "P08", "text": "では――/その1454円のうち、映画館に残るのは？", "lead": 0.2, "tail": 1.0, "pauses": {"1": 0.3}}
]
