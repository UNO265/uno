[
  {"id": "Q01", "text": "映画館は、/なぜポップコーンを売るのか？", "lead": 0.05, "tail": 0.2, "gap": 0.1},
  {"id": "Q02", "text": "主役は映画。/チケットを売ればいいはずなのに。", "lead": 0.1, "tail": 0.2, "gap": 0.12},
  {"id": "Q03", "text": "答えは、/売れる席の数に、限界があるから。", "lead": 0.15, "tail": 0.3, "gap": 0.15},
  {"id": "Q04", "text": "200席のスクリーンなら、/一回の上映で売れるチケットは、最大200枚。", "lead": 0.15, "tail": 0.2, "gap": 0.12},
  {"id": "Q05", "text": "上映が終わるまで、/次の客は入れられない。", "lead": 0.1, "tail": 0.25, "gap": 0.1},
  {"id": "Q06", "text": "でも、売店なら――/座席を増やさなくても、/一人の客が使う金額を増やせる。", "lead": 0.15, "tail": 0.2, "gap": 0.12},
  {"id": "Q07", "text": "ビジネスの言葉でいえば、/「客単価」だ。", "lead": 0.2, "tail": 0.5, "gap": 0.15},
  {"id": "Q08", "text": "では――/なぜポップコーンは、あんなに高いのか？", "lead": 0.2, "tail": 1.0, "pauses": {"1": 0.3}}
]
