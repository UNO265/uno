[
  {"id": "A01", "text": "100円ショップは、なぜ100円で儲かるのか？", "lead": 0.15, "tail": 0.3},
  {"id": "A02", "text": "国内の100円ショップ市場は、/約1兆1100億円。", "lead": 0.2, "tail": 0.35},
  {"id": "A03", "text": "でも、/100円の商品一つで、大きく儲けているわけではない。", "lead": 0.2, "tail": 0.35},
  {"id": "A04", "text": "手がかりは、三つ。", "lead": 0.2, "tail": 0.3},
  {"id": "A05", "text": "まず、/大量に仕入れて、/一つあたりのコストを下げる。", "lead": 0.2, "tail": 0.3, "gap": 0.2},
  {"id": "A06", "text": "次に、/原価の違う商品を組み合わせて、/店全体で利益を出す。", "lead": 0.2, "tail": 0.3, "gap": 0.2},
  {"id": "A07", "text": "そして、/「ついで買い」で、/一人あたりの買い物を増やす。", "lead": 0.2, "tail": 0.5, "gap": 0.2},
  {"id": "A08", "text": "100円は、ただの値段ではない。/ビジネスのルールだった。", "lead": 0.3, "tail": 0.6, "pauses": {"1": 0.6}},
  {"id": "A09", "text": "続きは本編で。/カネナゾ。", "lead": 0.2, "tail": 1.6}
]
