[
  {"id": "D01", "text": "100円。", "lead": 0.05, "tail": 0.15},
  {"id": "D02", "text": "コストが上がっても、/この値段を守れるのか？", "lead": 0.1, "tail": 0.2, "gap": 0.1},
  {"id": "D03", "text": "DAISOとSeriaは、/正反対の答えを選んだ。", "lead": 0.15, "tail": 0.3, "gap": 0.12},
  {"id": "D04", "text": "DAISOは、100円を超えていく。/200円。/300円。/500円。", "lead": 0.15, "tail": 0.2, "gap": 0.15},
  {"id": "D05", "text": "100円を入口にして、/その先の選択肢を広げている。", "lead": 0.15, "tail": 0.3, "gap": 0.15},
  {"id": "D06", "text": "一方、Seriaは、/100円にこだわる。", "lead": 0.15, "tail": 0.2, "gap": 0.12},
  {"id": "D07", "text": "値段を確かめずに選べる。/その分かりやすさが、価値になる。", "lead": 0.15, "tail": 0.3, "gap": 0.15},
  {"id": "D08", "text": "価格の壁を広げるDAISO。/価格の壁を守るSeria。/同じ100円ショップでも、戦い方は正反対だ。", "lead": 0.2, "tail": 0.5, "gap": 0.2, "pauses": {"2": 0.35}},
  {"id": "D09", "text": "では、そもそも――/100円で、なぜ儲かるのか。", "lead": 0.2, "tail": 1.0, "pauses": {"1": 0.3}}
]
