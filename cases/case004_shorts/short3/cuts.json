[
 {
  "id": "V01",
  "text": "コインランドリーに入れたお金、/どこへ消える？",
  "lead": 0.05,
  "tail": 0.2,
  "gap": 0.1
 },
 {
  "id": "V01B",
  "text": "客から見れば、お金を入れて、ボタンを押すだけ。/でも、そのお金は、そのまま店の利益にはならない。",
  "lead": 0.1,
  "tail": 0.25,
  "gap": 0.1
 },
 {
  "id": "V02",
  "text": "まず、機械が一回動くたびに。/水道。/電気やガス。/洗剤。",
  "lead": 0.1,
  "tail": 0.25,
  "gap": 0.1
 },
 {
  "id": "V03",
  "text": "客が来ても、来なくても。/家賃。/清掃。/点検や修理。",
  "lead": 0.1,
  "tail": 0.25,
  "gap": 0.1
 },
 {
  "id": "V04",
  "text": "そして、洗濯機と乾燥機、そのもの。",
  "lead": 0.1,
  "tail": 0.3
 },
 {
  "id": "V04B",
  "text": "何台もの大型の機械は、/置けば終わり、ではない。",
  "lead": 0.1,
  "tail": 0.25,
  "gap": 0.1
 },
 {
  "id": "V05",
  "text": "無人だから、売上のほとんどが利益――/というわけではない。",
  "lead": 0.15,
  "tail": 0.35,
  "gap": 0.15
 },
 {
  "id": "V06",
  "text": "では、人がいないのに、/なぜ儲かる？",
  "lead": 0.2,
  "tail": 1.3,
  "pauses": {
   "1": 0.2
  }
 }
]