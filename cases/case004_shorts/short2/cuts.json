[
 {
  "id": "U01",
  "text": "コインランドリー、/店の数は何倍？",
  "lead": 0.05,
  "tail": 0.2,
  "gap": 0.1
 },
 {
  "id": "U02",
  "text": "1996年、全国のコインランドリーは、/約1万店。",
  "lead": 0.1,
  "tail": 0.25,
  "gap": 0.1
 },
 {
  "id": "U03",
  "text": "2013年には、/1万6693店。/およそ1.6倍だ。",
  "lead": 0.1,
  "tail": 0.3,
  "gap": 0.12
 },
 {
  "id": "U04",
  "text": "その後も増え続け、/この10年で、さらに4割ほど増えたと報じられている。",
  "lead": 0.1,
  "tail": 0.25,
  "gap": 0.1
 },
 {
  "id": "U04B",
  "text": "お金も同じだ。/2025年、コインランドリーの市場は、/1155億円。",
  "lead": 0.1,
  "tail": 0.3,
  "gap": 0.12
 },
 {
  "id": "U05",
  "text": "家には、たいてい洗濯機がある。/それなのに、店は増えている。",
  "lead": 0.15,
  "tail": 0.3,
  "gap": 0.12
 },
 {
  "id": "U06",
  "text": "客はいったい、/何を買ってる？",
  "lead": 0.2,
  "tail": 1.3,
  "pauses": {
   "1": 0.2
  }
 }
]