[
 {
  "id": "S01",
  "text": "送料無料、/本当に無料？",
  "lead": 0.05,
  "tail": 0.2,
  "gap": 0.1
 },
 {
  "id": "S02",
  "text": "注文画面は、「送料0円」。/でも、荷物を運ぶ仕事は、確かにある。",
  "lead": 0.1,
  "tail": 0.2,
  "gap": 0.1
 },
 {
  "id": "S02B",
  "text": "倉庫から、仕分けの拠点、/夜のトラック、そして玄関まで。",
  "lead": 0.1,
  "tail": 0.2,
  "gap": 0.1
 },
 {
  "id": "S03",
  "text": "ヤマト運輸の宅配便の平均単価は、/1個711円。/大口の割引も含めた平均だ。",
  "lead": 0.1,
  "tail": 0.3,
  "gap": 0.15
 },
 {
  "id": "S04",
  "text": "運送会社は、荷物1個ごとに、運賃を受け取っている。",
  "lead": 0.1,
  "tail": 0.2
 },
 {
  "id": "S05",
  "text": "つまり、運ぶお金は、0円ではない。/見えなくなっているだけだ。",
  "lead": 0.15,
  "tail": 0.4,
  "gap": 0.15
 },
 {
  "id": "S06",
  "text": "では――その送料は、/誰が払う？",
  "lead": 0.2,
  "tail": 1.3
 }
]