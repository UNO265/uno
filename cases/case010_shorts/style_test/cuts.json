[
 {"id": "T01", "text": "値引きで、本部が損するのは、/たった6円？", "lead": 0.05, "tail": 0.2, "gap": 0.1},
 {"id": "T02", "text": "80円で仕入れたおにぎりを、100円で10個。/2個が売れ残った。", "lead": 0.1, "tail": 0.2, "gap": 0.1},
 {"id": "T03", "text": "捨てると、本部は56円。/店は、マイナス56円。", "lead": 0.1, "tail": 0.25, "gap": 0.12},
 {"id": "T04", "text": "50円で売り切ると、/本部は50円、店はプラス50円。", "lead": 0.1, "tail": 0.25, "gap": 0.12},
 {"id": "T05", "text": "店は106円よくなり、/本部は、6円減るだけ。", "lead": 0.1, "tail": 0.35, "gap": 0.15},
 {"id": "T06", "text": "それなら、コンビニは、/なぜ値引きせず捨てる？", "lead": 0.15, "tail": 0.8, "gap": 0.12}
]
