 "narration": [
  {
   "id": "N01",
   "win": [
    6.2,
    7.9
   ],
   "ko": "심한 말더듬을 갖고 있는 딸",
   "ja": "ひどく、どもる娘。",
   "sub": "ひどく、どもる娘"
  },
  {
   "id": "N02",
   "win": [
    13.55,
    17.7
   ],
   "ko": "그날 이후 소녀와 앵무새는 서로 말을 가르치고 배우며 둘도 없는 친구가 되어갔죠",
   "ja": "その日から少女とオウムは言葉を教え合い、大切な友達になりました。",
   "sub": "その日から少女とオウムは|言葉を教え合い、|大切な友達になりました"
  },
  {
   "id": "N03",
   "win": [
    30.05,
    32.75
   ],
   "ko": "하지만 마리의 아버지는 그 모습이 못마땅했는데요",
   "ja": "でも、マリーの父はそれが気に入りません。",
   "sub": "でも、マリーの父は|それが気に入りません"
  },
  {
   "id": "N04",
   "win": [
    37.35,
    40.25
   ],
   "ko": "부모님의 대화를 들은 마리는 폴리를 어디론가 데려갑니다",
   "ja": "話を聞いたマリーは、ポーリーを連れ出します。",
   "sub": "話を聞いたマリーは、|ポーリーを連れ出します"
  },
  {
   "id": "N05",
   "win": [
    60.5,
    66.2
   ],
   "ko": "그렇게 전당포로 오게 된 폴리, 꼬여버린 자신의 조생을 비관하며 살아가던 앵무새 앞에",
   "ja": "こうして質屋に来たポーリー。こじれた身の上を嘆くオウムの前に、",
   "sub": "こうして質屋に来たポーリー|こじれた身の上を嘆く|オウムの前に、"
  },
  {
   "id": "N06",
   "win": [
    66.25,
    68.5
   ],
   "ko": "마음씨 착한 할머니 아이비가 나타납니다",
   "ja": "優しいアイビーが現れます。",
   "sub": "優しいアイビーが現れます"
  },
  {
   "id": "N07",
   "win": [
    72.55,
    75.75
   ],
   "ko": "폴리는 진상을 부리며 자신을 마리에게 데려가 달라고 말하는데요",
   "ja": "ポーリーは、マリーの所へ連れていけとせがみます。",
   "sub": "ポーリーは、|マリーの所へ|連れていけとせがみます"
  },
  {
   "id": "N08",
   "win": [
    83.2,
    86.85
   ],
   "ko": "그렇게 그녀가 살던 집으로 찾아갔지만 이미 이사를 가버린 지 오래였죠",
   "ja": "マリーの家を訪ねますが、一家はもう引っ越していました。",
   "sub": "マリーの家を訪ねますが、|一家はもう引っ越していました"
  },
  {
   "id": "N09",
   "win": [
    95.45,
    99.78
   ],
   "ko": "캠핑카로 여행하며 그림을 그리던 아이비의 제안으로 폴리는 그녀의 여행 동반자가 되는데요",
   "ja": "旅をしながら絵を描くアイビーに誘われ、ポーリーは旅の相棒に。",
   "sub": "旅をしながら|絵を描くアイビーに誘われ、|ポーリーは旅の相棒に"
  },
  {
   "id": "N10",
   "win": [
    99.82,
    104.85
   ],
   "ko": "그렇게 시작된 여정 속에서 아이비는 폴리에게 말하는 예절과 인생을 가르쳐주며 우정을 쌓아가죠",
   "ja": "旅の中でアイビーは、話し方と生き方を教え、二人の友情は深まります。",
   "sub": "旅の中でアイビーは、|話し方と生き方を教え、|二人の友情は深まります"
  },
  {
   "id": "N11",
   "win": [
    110.7,
    111.5
   ],
   "ko": "그러던 어느 날",
   "ja": "そんなある日。",
   "sub": "そんなある日"
  },
  {
   "id": "N12",
   "win": [
    113.6,
    116.2
   ],
   "ko": "지병을 이기지 못한 아이비가 세상을 떠나게 됩니다",
   "ja": "持病に勝てず、アイビーは亡くなります。",
   "sub": "持病に勝てず、|アイビーは亡くなります"
  },
  {
   "id": "N13",
   "win": [
    130.25,
    135.45
   ],
   "ko": "이제 그는 영혼의 단짝 마리가 있을 곳을 향해 밤낮으로 날아갑니다 / 그 여정은 결코 짧지 않았습니다",
   "ja": "ポーリーは、マリーのいる場所へ昼も夜も飛び続けます。長い旅でした。",
   "sub": "ポーリーは、|マリーのいる場所へ|昼も夜も飛び続けます|長い旅でした"
  },
  {
   "id": "N14",
   "win": [
    135.5,
    141.65
   ],
   "ko": "잠시나마 사랑에도 빠져봤죠 / 하지만 도처에 도사린 인간들의 이기심은 폴리에게 지울 수 없는 배신의 상처만을 남겼습니다",
   "ja": "恋もしました。でも、人間の身勝手さに何度も裏切られ、心に傷が残りました。",
   "sub": "恋もしました|でも、人間の身勝手さに|何度も裏切られ、|心に傷が残りました"
  },
  {
   "id": "N15",
   "win": [
    141.7,
    146.05
   ],
   "ko": "깊은 상처로 인해 폴리는 입을 꼭 닫아버렸고 쓸모가 없어지자 결국 버려지게 됩니다",
   "ja": "深く傷ついたポーリーは口を閉ざし、役に立たないと捨てられてしまいます。",
