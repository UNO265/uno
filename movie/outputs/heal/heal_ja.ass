Dialogue: 1,0:00:00.00,0:02:18.37,Title,,0,0,0,,{\pos(540,210)}{\c&HFFFFFF&}帰宅したら{\c&H0049DCFF&}他人がいた
Dialogue: 0,0:00:02.50,0:00:03.10,Dia,,0,0,0,,{\pos(540,1302)}出てって！
Dialogue: 0,0:00:03.10,0:00:04.21,Dia,,0,0,0,,{\pos(540,1302)}すまない！
Dialogue: 0,0:00:04.21,0:00:05.60,Narr,,0,0,0,,{\pos(540,1302)}久々に家へ帰ると…
Dialogue: 0,0:00:05.60,0:00:06.40,Dia,,0,0,0,,{\pos(540,1302)}だ…大丈夫です
Dialogue: 0,0:00:06.40,0:00:06.90,Dia,,0,0,0,,{\pos(540,1302)}わ、私…
Dialogue: 0,0:00:06.90,0:00:07.90,Dia,,0,0,0,,{\pos(540,1302)}彼氏がすぐ来るわ！
Dialogue: 0,0:00:07.90,0:00:09.10,Dia,,0,0,0,,{\pos(540,1302)}危害は加えません
Dialogue: 0,0:00:09.10,0:00:10.28,Dia,,0,0,0,,{\pos(540,1302)}ここは私の部屋です
Dialogue: 0,0:00:10.28,0:00:11.50,Narr,,0,0,0,,{\pos(540,1302)}そこには先客が
Dialogue: 0,0:00:11.50,0:00:12.00,Dia,,0,0,0,,{\pos(540,1302)}うわっ！
Dialogue: 0,0:00:12.00,0:00:12.40,Dia,,0,0,0,,{\pos(540,1302)}なんだ！
Dialogue: 0,0:00:13.00,0:00:13.90,Dia,,0,0,0,,{\pos(540,1302)}誰だ、お前！
Dialogue: 0,0:00:13.90,0:00:14.70,Dia,,0,0,0,,{\pos(540,1302)}この人、さっき
Dialogue: 0,0:00:14.70,0:00:15.60,Dia,,0,0,0,,{\pos(540,1302)}鍵を持ってるって
Dialogue: 0,0:00:15.60,0:00:16.20,Dia,,0,0,0,,{\pos(540,1302)}言ってたの
Dialogue: 0,0:00:16.20,0:00:16.80,Dia,,0,0,0,,{\pos(540,1302)}鍵を？
Dialogue: 0,0:00:16.80,0:00:17.50,Dia,,0,0,0,,{\pos(540,1302)}もちろんです
Dialogue: 0,0:00:17.50,0:00:18.60,Dia,,0,0,0,,{\pos(540,1302)}私の部屋ですから
Dialogue: 0,0:00:18.60,0:00:20.60,Dia,,0,0,0,,{\pos(540,1302)}ここに25年住んでいます
Dialogue: 0,0:00:20.60,0:00:21.70,Dia,,0,0,0,,{\pos(540,1302)}なぜ留守だった？
Dialogue: 0,0:00:21.70,0:00:23.10,Dia,,0,0,0,,{\pos(540,1302)}コネチカット住まいで
Dialogue: 0,0:00:23.10,0:00:24.10,Dia,,0,0,0,,{\pos(540,1302)}ここは久しぶりで
Dialogue: 0,0:00:24.10,0:00:25.00,Dia,,0,0,0,,{\pos(540,1302)}警察は呼んだ？
Dialogue: 0,0:00:25.00,0:00:25.50,Dia,,0,0,0,,{\pos(540,1302)}いいえ
Dialogue: 0,0:00:25.50,0:00:26.40,Dia,,0,0,0,,{\pos(540,1302)}イヴァンって知ってる？
Dialogue: 0,0:00:26.40,0:00:27.60,Dia,,0,0,0,,{\pos(540,1302)}知りません。誰です？
Dialogue: 0,0:00:27.60,0:00:28.90,Dia,,0,0,0,,{\pos(540,1302)}この部屋を貸した男だ
Dialogue: 0,0:00:28.90,0:00:29.80,Dia,,0,0,0,,{\pos(540,1302)}全然知りません
Dialogue: 0,0:00:29.80,0:00:30.80,Dia,,0,0,0,,{\pos(540,1302)}ここは私の部屋です
Dialogue: 0,0:00:30.80,0:00:31.60,Dia,,0,0,0,,{\pos(540,1302)}本当です
Dialogue: 0,0:00:31.60,0:00:32.56,Dia,,0,0,0,,{\pos(540,1302)}くそっ！
Dialogue: 0,0:00:32.56,0:00:34.10,Narr,,0,0,0,,{\pos(540,1302)}二人は詐欺に遭ったのです
Dialogue: 0,0:00:34.10,0:00:34.70,Dia,,0,0,0,,{\pos(540,1302)}なあ
Dialogue: 0,0:00:35.10,0:00:36.00,Dia,,0,0,0,,{\pos(540,1302)}揉め事はごめんだ
Dialogue: 0,0:00:36.00,0:00:37.40,Dia,,0,0,0,,{\pos(540,1302)}すぐに出ていくよ
Dialogue: 0,0:00:37.40,0:00:38.20,Dia,,0,0,0,,{\pos(540,1302)}鍵、返すよ
Dialogue: 0,0:00:38.20,0:00:39.50,Dia,,0,0,0,,{\pos(540,1302)}誤解だった、すまない
Dialogue: 0,0:00:39.50,0:00:40.70,Dia,,0,0,0,,{\pos(540,1302)}出ていくよ、いいね？
Dialogue: 0,0:00:40.70,0:00:41.20,Dia,,0,0,0,,{\pos(540,1302)}ええ
Dialogue: 0,0:00:43.40,0:00:44.80,Dia,,0,0,0,,{\pos(540,1302)}ここにはどのくらい？
Dialogue: 0,0:00:44.80,0:00:45.50,Dia,,0,0,0,,{\pos(540,1302)}2か月です
Dialogue: 0,0:00:45.50,0:00:46.60,Dia,,0,0,0,,{\pos(540,1302)}お金も払います
Dialogue: 0,0:00:47.50,0:00:48.50,Dia,,0,0,0,,{\pos(540,1302)}本当にすみません
Dialogue: 0,0:00:48.50,0:00:49.70,Dia,,0,0,0,,{\pos(540,1302)}ご理解に感謝します
Dialogue: 0,0:00:50.20,0:00:51.00,Dia,,0,0,0,,{\pos(540,1302)}さようなら
Dialogue: 0,0:00:51.00,0:00:52.21,Dia,,0,0,0,,{\pos(540,1302)}さようなら
Dialogue: 0,0:00:52.21,0:00:53.61,Narr,,0,0,0,,{\pos(540,1302)}二人は結局
Dialogue: 0,0:00:53.61,0:00:55.05,Narr,,0,0,0,,{\pos(540,1302)}部屋を出ていきます
Dialogue: 0,0:00:57.21,0:00:59.22,Narr,,0,0,0,,{\pos(540,1302)}そこへ近づいてきた老人
Dialogue: 0,0:01:00.10,0:01:01.60,Dia,,0,0,0,,{\pos(540,1302)}これ、忘れ物です
Dialogue: 0,0:01:01.60,0:01:02.20,Dia,,0,0,0,,{\pos(540,1302)}どうも
Dialogue: 0,0:01:03.40,0:01:05.00,Dia,,0,0,0,,{\pos(540,1302)}今夜、泊まる所は？
Dialogue: 0,0:01:05.00,0:01:05.70,Dia,,0,0,0,,{\pos(540,1302)}ええ
Dialogue: 0,0:01:05.70,0:01:06.70,Dia,,0,0,0,,{\pos(540,1302)}友達に連絡します
Dialogue: 0,0:01:09.30,0:01:10.80,Dia,,0,0,0,,{\pos(540,1302)}泊めてくれてありがとう
Dialogue: 0,0:01:10.80,0:01:11.80,Dia,,0,0,0,,{\pos(540,1302)}おかげで
Dialogue: 0,0:01:11.80,0:01:12.76,Dia,,0,0,0,,{\pos(540,1302)}本当に助かったよ
Dialogue: 0,0:01:12.76,0:01:14.26,Narr,,0,0,0,,{\pos(540,1302)}見かねたウォルターは
Dialogue: 0,0:01:14.26,0:01:16.40,Narr,,0,0,0,,{\pos(540,1302)}ひとまず二人を家に入れます
Dialogue: 0,0:01:16.40,0:01:17.10,Dia,,0,0,0,,{\pos(540,1302)}おやすみ
Dialogue: 0,0:01:18.40,0:01:19.20,Dia,,0,0,0,,{\pos(540,1302)}おはよう
Dialogue: 0,0:01:19.20,0:01:20.10,Dia,,0,0,0,,{\pos(540,1302)}おはようございます
Dialogue: 0,0:01:20.10,0:01:21.20,Dia,,0,0,0,,{\pos(540,1302)}コーヒーを淹れました
Dialogue: 0,0:01:21.20,0:01:22.00,Dia,,0,0,0,,{\pos(540,1302)}ありがとう
Dialogue: 0,0:01:22.00,0:01:22.93,Dia,,0,0,0,,{\pos(540,1302)}良い一日を
Dialogue: 0,0:01:22.93,0:01:23.60,Dia,,0,0,0,,{\pos(540,1302)}はい
Dialogue: 0,0:01:24.66,0:01:26.50,Narr,,0,0,0,,{\pos(540,1302)}大学教授のウォルターは
Dialogue: 0,0:01:26.50,0:01:28.01,Narr,,0,0,0,,{\pos(540,1302)}妻を亡くして以来
Dialogue: 0,0:01:28.01,0:01:30.17,Narr,,0,0,0,,{\pos(540,1302)}無気力に暮らしていました
Dialogue: 0,0:01:30.17,0:01:31.95,Narr,,0,0,0,,{\pos(540,1302)}論文を書く情熱も
Dialogue: 0,0:01:31.95,0:01:33.53,Narr,,0,0,0,,{\pos(540,1302)}習っていたピアノへの興味も
Dialogue: 0,0:01:33.53,0:01:35.10,Narr,,0,0,0,,{\pos(540,1302)}失っていたのです
Dialogue: 0,0:01:35.10,0:01:36.60,Dia,,0,0,0,,{\pos(540,1302)}ウォルター、おかえり
Dialogue: 0,0:01:36.60,0:01:37.20,Dia,,0,0,0,,{\pos(540,1302)}やあ
Dialogue: 0,0:01:41.50,0:01:42.90,Dia,,0,0,0,,{\pos(540,1302)}練習、続けてください
Dialogue: 0,0:01:43.40,0:01:43.80,Dia,,0,0,0,,{\pos(540,1302)}本当に？
Dialogue: 0,0:01:43.80,0:01:44.80,Dia,,0,0,0,,{\pos(540,1302)}邪魔じゃない？
Dialogue: 0,0:01:44.80,0:01:45.60,Dia,,0,0,0,,{\pos(540,1302)}構いませんよ
Dialogue: 0,0:01:45.60,0:01:46.50,Dia,,0,0,0,,{\pos(540,1302)}どうも
Dialogue: 0,0:01:46.50,0:01:47.50,Dia,,0,0,0,,{\pos(540,1302)}ズボンははくよ
Dialogue: 0,0:01:49.90,0:01:50.80,Dia,,0,0,0,,{\pos(540,1302)}あの
Dialogue: 0,0:01:51.30,0:01:52.50,Dia,,0,0,0,,{\pos(540,1302)}ザイナブが夕食を作る
Dialogue: 0,0:01:52.50,0:01:53.90,Dia,,0,0,0,,{\pos(540,1302)}よければ一緒にどう？
Dialogue: 0,0:01:53.90,0:01:54.70,Dia,,0,0,0,,{\pos(540,1302)}ありがとう
Dialogue: 0,0:01:56.20,0:01:57.60,Dia,,0,0,0,,{\pos(540,1302)}夕食、ごちそうさま
Dialogue: 0,0:01:57.60,0:01:58.40,Dia,,0,0,0,,{\pos(540,1302)}おいしかった
Dialogue: 0,0:01:58.40,0:01:59.20,Dia,,0,0,0,,{\pos(540,1302)}どういたしまして
Dialogue: 0,0:01:59.20,0:02:00.10,Dia,,0,0,0,,{\pos(540,1302)}もう行かないと
Dialogue: 0,0:02:00.10,0:02:01.00,Dia,,0,0,0,,{\pos(540,1302)}ライブがあるんだ
Dialogue: 0,0:02:01.00,0:02:01.70,Dia,,0,0,0,,{\pos(540,1302)}よかったら
Dialogue: 0,0:02:01.70,0:02:02.30,Dia,,0,0,0,,{\pos(540,1302)}来ていいよ
Dialogue: 0,0:02:02.30,0:02:02.90,Dia,,0,0,0,,{\pos(540,1302)}いや
Dialogue: 0,0:02:02.90,0:02:04.00,Dia,,0,0,0,,{\pos(540,1302)}仕事が残っていて
Dialogue: 0,0:02:04.00,0:02:04.60,Dia,,0,0,0,,{\pos(540,1302)}ありがとう
Dialogue: 0,0:02:04.60,0:02:05.10,Dia,,0,0,0,,{\pos(540,1302)}そうか
Dialogue: 0,0:02:05.10,0:02:05.80,Dia,,0,0,0,,{\pos(540,1302)}また今度
Dialogue: 0,0:02:05.80,0:02:06.30,Dia,,0,0,0,,{\pos(540,1302)}ええ
Dialogue: 0,0:02:06.40,0:02:07.80,Cap,,0,0,0,,{\pos(540,1302)}（フランス語で会話）
Dialogue: 0,0:02:08.20,0:02:08.70,Dia,,0,0,0,,{\pos(540,1302)}あの…
Dialogue: 0,0:02:09.30,0:02:09.80,Dia,,0,0,0,,{\pos(540,1302)}よければ
Dialogue: 0,0:02:09.80,0:02:10.90,Dia,,0,0,0,,{\pos(540,1302)}私も行きたいんだが
Dialogue: 0,0:02:10.90,0:02:11.40,Dia,,0,0,0,,{\pos(540,1302)}いいね！
