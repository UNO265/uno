  "narration": [
    {
      "start": 0.2,
      "say": "リクガメ社員、出社。",
      "sub": "リクガメ社員、出社。",
      "ko": "리크가메 사원, 출근.",
      "hl": "出社"
    },
    {
      "start": 2.1,
      "say": "まずは、デザインの確認。",
      "sub": "まずは、デザインの確認。",
      "ko": "먼저, 디자인 확인.",
      "voice": false
    },
    {
      "start": 3.4,
      "say": "朝食は、手早く済ませる。",
      "sub": "朝食は、手早く済ませる。",
      "ko": "아침은, 재빨리 해치운다.",
      "hl": "手早く",
      "voice": false
    },
    {
      "start": 6.4,
      "say": "午後は、カフェで打ち合わせ。",
      "sub": "午後は、\nカフェで打ち合わせ。",
      "ko": "오후는, 카페에서 미팅.",
      "hl": "打ち合わせ"
    },
    {
      "start": 9.4,
      "say": "睡魔との、戦い。",
      "sub": "……睡魔との戦い。",
      "ko": "……졸음과의 싸움.",
      "hl": "睡魔"
    },
    {
      "start": 12.4,
      "say": "昼食は、全力。",
      "sub": "昼食は、全力。",
      "ko": "점심은, 전력.",
      "hl": "全力"
    },
    {
      "start": 15.5,
      "say": "上司からの、差し入れ。",
      "sub": "上司からの、差し入れ。",
      "ko": "상사로부터의, 간식.",
      "hl": "差し入れ",
      "voice": false
    },
    {
      "start": 18.2,
      "say": "褒められると、伸びるタイプ。",
      "sub": "褒められると、\n伸びるタイプ。",
      "ko": "칭찬받으면, 크는 타입.",
      "hl": "伸びるタイプ"
    },
    {
      "start": 20.25,
      "say": "退勤後の姿が、こちら。",
      "sub": "退勤後の姿が、\nこちら。",
      "ko": "퇴근 후의 모습이, 이쪽.",
      "hl": "こちら",
